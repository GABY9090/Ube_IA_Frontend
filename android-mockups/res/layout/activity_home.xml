<?xml version="1.0" encoding="utf-8"?>
<!--
  ÉCRAN 1 — PAGE D'ACCUEIL
  Message de bienvenue + 6 cartes de suggestions en grille 2 colonnes
  + barre de saisie fixée en bas

  À placer dans: res/layout/activity_home.xml
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_light">

    <!-- En-tête: logo + nom + avatar -->
    <LinearLayout
        android:id="@+id/header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Logo Université de Bourgogne -->
        <FrameLayout
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/bg_logo_square">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="uB"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                android:fontFamily="serif" />
        </FrameLayout>

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="DataQuery AI"
            android:textSize="17sp"
            android:textStyle="bold"
            android:textColor="@color/text_light_primary" />

        <!-- Avatar utilisateur -->
        <FrameLayout
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_profile_avatar">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_gravity="center"
                android:src="@android:drawable/ic_menu_myplaces"
                android:tint="@color/white"
                tools:ignore="UseAppTint" />
        </FrameLayout>
    </LinearLayout>

    <!-- Section hero: icône + titre + sous-titre -->
    <LinearLayout
        android:id="@+id/hero_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="28dp"
        app:layout_constraintTop_toBottomOf="@id/header">

        <!-- Icône hero dans boîte dégradé bordeaux -->
        <FrameLayout
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="@drawable/bg_hero_icon"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@android:drawable/btn_star_big_on"
                android:tint="@color/white"
                tools:ignore="UseAppTint" />
        </FrameLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/welcome_title"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="@color/text_light_primary"
            android:lineSpacingExtra="2dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/welcome_subtitle"
            android:textSize="15sp"
            android:textColor="@color/text_light_tertiary"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>

    <!-- Label "Suggestions" -->
    <TextView
        android:id="@+id/suggestions_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/suggestions_label"
        android:textSize="13sp"
        android:textStyle="bold"
        android:textColor="@color/text_light_muted"
        android:textAllCaps="true"
        android:letterSpacing="0.05"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        app:layout_constraintTop_toBottomOf="@id/hero_section" />

    <!-- Grille de 6 suggestions (2 colonnes) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/suggestions_grid"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false"
        app:layoutManager="androidx.recyclerview.widget.GridLayoutManager"
        app:spanCount="2"
        app:layout_constraintTop_toBottomOf="@id/suggestions_label"
        app:layout_constraintBottom_toTopOf="@id/input_section"
        tools:listitem="@layout/item_suggestion_card"
        tools:itemCount="6" />

    <!-- Section de saisie fixée en bas -->
    <LinearLayout
        android:id="@+id/input_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- Pill de saisie -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_input_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp">

            <EditText
                android:id="@+id/input_field"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/input_placeholder"
                android:textColorHint="@color/text_light_muted"
                android:textSize="14sp"
                android:textColor="@color/text_light_primary"
                android:inputType="textMultiLine"
                android:maxLines="3"
                android:imeOptions="actionSend" />

            <!-- Bouton d'envoi -->
            <FrameLayout
                android:id="@+id/send_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_send_button"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_menu_send"
                    android:tint="@color/white"
                    tools:ignore="UseAppTint" />
            </FrameLayout>
        </LinearLayout>

        <!-- Disclaimer -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/disclaimer"
            android:textSize="11sp"
            android:textColor="@color/text_light_muted"
            android:lineSpacingExtra="1dp"
            android:gravity="center" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
