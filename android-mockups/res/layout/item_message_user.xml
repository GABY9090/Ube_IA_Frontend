<?xml version="1.0" encoding="utf-8"?>
<!--
  MESSAGE UTILISATEUR (bulle)
  Alignée à droite, fond bordeaux, texte blanc

  À placer dans: res/layout/item_message_user.xml
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="end"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/user_message_text"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="280dp"
        android:background="@drawable/bg_user_bubble"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:textSize="14sp"
        android:textColor="@color/white"
        android:lineSpacingExtra="2dp"
        tools:text="Évolution de la mortalité cardiovasculaire en France" />
</LinearLayout>
