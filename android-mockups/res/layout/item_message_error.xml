<?xml version="1.0" encoding="utf-8"?>
<!--
  ERREUR — QUESTION HORS SUJET
  Bannière avec icône + titre + message

  À placer dans: res/layout/item_message_error.xml
  Type d'erreur contrôlé par la visibilité des sections
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Avatar assistant -->
    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_assistant_avatar">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@android:drawable/btn_star_big_on"
            android:tint="@color/white"
            tools:ignore="UseAppTint" />
    </FrameLayout>

    <!-- Corps -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <!-- Nom -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/assistant_name"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_light_secondary" />

        <!-- Bannière d'erreur: hors sujet -->
        <LinearLayout
            android:id="@+id/error_out_of_scope"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start"
            android:background="@drawable/bg_explain_box"
            android:padding="14dp"
            android:visibility="visible">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:src="@android:drawable/ic_dialog_alert"
                android:tint="@color/bordeaux_600"
                tools:ignore="UseAppTint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/error_out_of_scope_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_light_secondary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/error_out_of_scope_msg"
                    android:textSize="13sp"
                    android:textColor="@color/text_light_tertiary"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bannière d'erreur: aucun résultat -->
        <LinearLayout
            android:id="@+id/error_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start"
            android:background="@color/bg_light_chip"
            android:padding="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:src="@android:drawable/ic_menu_info_details"
                android:tint="@color/text_light_muted"
                tools:ignore="UseAppTint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/error_empty_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_light_secondary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/error_empty_msg"
                    android:textSize="13sp"
                    android:textColor="@color/text_light_tertiary"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Bannière d'erreur: connexion -->
        <LinearLayout
            android:id="@+id/error_connection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="start"
            android:background="#FEF2F2"
            android:padding="14dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginEnd="10dp"
                android:src="@android:drawable/ic_dialog_alert"
                android:tint="@color/error"
                tools:ignore="UseAppTint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/error_connection_title"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_light_secondary"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/error_connection_msg"
                    android:textSize="13sp"
                    android:textColor="@color/text_light_tertiary"
                    android:lineSpacingExtra="2dp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
