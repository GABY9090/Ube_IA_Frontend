<?xml version="1.0" encoding="utf-8"?>
<!--
  MESSAGE ASSISTANT — ÉTAT DE CHARGEMENT
  Avatar + nom + 3 étapes animées (check / spinner / pending)

  À placer dans: res/layout/item_message_loading.xml
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <!-- Avatar assistant -->
    <FrameLayout
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_assistant_avatar">

        <ImageView
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="center"
            android:src="@android:drawable/btn_star_big_on"
            android:tint="@color/white"
            tools:ignore="UseAppTint" />
    </FrameLayout>

    <!-- Corps -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:orientation="vertical">

        <!-- Nom -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="@string/assistant_name"
            android:textSize="13sp"
            android:textStyle="bold"
            android:textColor="@color/text_light_secondary" />

        <!-- Étape 1: Terminée (check vert) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:src="@android:drawable/ic_menu_done"
                android:tint="@color/success"
                tools:ignore="UseAppTint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading_step_1"
                android:textSize="13sp"
                android:textColor="@color/text_light_muted"
                android:alpha="0.6" />
        </LinearLayout>

        <!-- Étape 2: Terminée (check vert) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:src="@android:drawable/ic_menu_done"
                android:tint="@color/success"
                tools:ignore="UseAppTint" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading_step_2"
                android:textSize="13sp"
                android:textColor="@color/text_light_muted"
                android:alpha="0.6" />
        </LinearLayout>

        <!-- Étape 3: En cours (spinner bordeaux) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ProgressBar
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:layout_marginEnd="8dp"
                android:indeterminateTint="@color/bordeaux_500" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/loading_step_3"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/text_light_primary" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
