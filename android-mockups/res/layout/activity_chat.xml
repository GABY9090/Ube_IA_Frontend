<?xml version="1.0" encoding="utf-8"?>
<!--
  ÉCRAN 2 — CONVERSATION
  En-tête avec menu burger + sélecteur de source
  Liste de messages (RecyclerView)
  Barre de saisie fixée en bas

  À placer dans: res/layout/activity_chat.xml
  Utilise: DrawerLayout pour le menu latéral (voir nav_drawer.xml)
-->
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Contenu principal -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/bg_light">

        <!-- En-tête de conversation -->
        <LinearLayout
            android:id="@+id/chat_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="20dp"
            android:paddingTop="6dp"
            android:paddingBottom="12dp"
            android:background="@color/bg_light_card"
            android:elevation="1dp"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Bouton menu burger -->
            <ImageButton
                android:id="@+id/burger_button"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_sort_by_size"
                android:tint="@color/text_light_tertiary"
                tools:ignore="UseAppTint" />

            <!-- Logo petit (mobile) -->
            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/bg_logo_square"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="uB"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:fontFamily="serif" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="DataQuery AI"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/text_light_primary" />

            <!-- Chip de source de données -->
            <LinearLayout
                android:id="@+id/ds_chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_ds_chip"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="5dp"
                android:paddingBottom="5dp"
                android:clickable="true"
                android:focusable="true">

                <!-- Point vert de statut -->
                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_status_connected" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:text="PostgreSQL"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_light_tertiary" />

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_marginStart="4dp"
                    android:src="@android:drawable/arrow_down_footer"
                    android:tint="@color/text_light_muted"
                    tools:ignore="UseAppTint" />
            </LinearLayout>
        </LinearLayout>

        <!-- Liste des messages -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/messages_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="16dp"
            android:paddingBottom="16dp"
            android:clipToPadding="false"
            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager"
            android:stackFromBottom="true"
            app:layout_constraintTop_toBottomOf="@id/chat_header"
            app:layout_constraintBottom_toTopOf="@id/chat_input_section"
            tools:listitem="@layout/item_message_assistant" />

        <!-- Barre de saisie fixée en bas -->
        <LinearLayout
            android:id="@+id/chat_input_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="8dp"
            android:paddingBottom="16dp"
            android:background="@color/bg_light"
            app:layout_constraintBottom_toBottomOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_input_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="10dp"
                android:paddingBottom="10dp">

                <EditText
                    android:id="@+id/chat_input_field"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/input_placeholder"
                    android:textColorHint="@color/text_light_muted"
                    android:textSize="14sp"
                    android:textColor="@color/text_light_primary"
                    android:inputType="textMultiLine"
                    android:maxLines="3"
                    android:imeOptions="actionSend" />

                <FrameLayout
                    android:id="@+id/chat_send_button"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:layout_marginStart="10dp"
                    android:background="@drawable/bg_send_button"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="17dp"
                        android:layout_height="17dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_send"
                        android:tint="@color/white"
                        tools:ignore="UseAppTint" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Menu latéral (drawer) -->
    <include layout="@layout/nav_drawer" />
</androidx.drawerlayout.widget.DrawerLayout>
